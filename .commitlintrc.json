{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "body-max-line-length": [1, "always", 150],
    "type-empty": [2, "never"],
    "scope-empty": [2, "never"],
    "subject-empty": [2, "never"],
    "scope-enum": [2, "always", [
      "application", "testdata", "coverage",
      "ai", "docker", "ci", "config",
      "architecture", "deps", "docs"
    ]],
    "subject-case": [2, "always", [
      "lower-case", "sentence-case", "camel-case"
    ]],
    "type-enum": [2, "always", [
      "feat", "fix", "docs", "style", "refactor",
      "perf", "test", "build", "ci", "chore", "revert"
    ]]
  }
}
